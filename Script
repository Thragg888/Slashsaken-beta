-- SOUND HOOK
-- ==========================================
local soundTriggerSet = {}
for _, id in ipairs(IDS.autoBlockTriggerSounds) do soundTriggerSet[id] = true end

local function extractSoundId(s)
    if not s or not s.SoundId then return nil end
    local sid = tostring(s.SoundId)
    return sid:match("rbxassetid://(%d+)") or sid:match("://(%d+)") or sid:match("^(%d+)$")
end

local function attemptSound(s, idp, mode)
    if not S.autoBlockAudioOn or H.isHelpless() or H.m1Locked() then return end
    if not s or not s:IsA("Sound") or not s.IsPlaying then return end
    local now = tick()
    local hk = S.soundHooks[s]
    local id = idp or (hk and hk.id) or extractSoundId(s)
    if not id or not soundTriggerSet[id] then return end
    if S.soundBlocked[s] and now < S.soundBlocked[s] then return end
    if now - S.lastBlock < S.LOCAL_CD then return end
    local mr = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
    if not mr then return end
    local hrp = hk and hk.hrp
    if not hrp then
        local p = s.Parent
        if p and p:IsA("BasePart") then hrp = p
        elseif p and p:IsA("Attachment") and p.Parent and p.Parent:IsA("BasePart") then hrp = p.Parent end
        if not hrp then return end
    end
    if not H.inBlockZone(mr, hrp) or not H.hasLOS(hrp) then return end
    local km = hrp.Parent
    if km and H.isFlicking(km, mr, hrp) then return end
    if S.blockdelay > 0 then task.wait(S.blockdelay) end
    if mode == "Block" and S.abToggles.Block then
        if S.messageOn and S.messageBlock then
            pcall(function() H.sendMsg(S.messageBlock) end)
        end
        H.fireBlock()
    end
    if mode == "Charge" and S.abToggles.Charge then H.fireCharge() end
    if mode == "Clone"  and S.abToggles.Clone  then H.fireClone()  end
    S.lastBlock = now; S.soundBlocked[s] = now + 1.0
end

local function hookSound(s)
    if not s or not s:IsA("Sound") or S.soundHooks[s] then return end
    local pre = extractSoundId(s)
    S.soundHooks[s] = {id=pre}
    local function fire()
        if S.abToggles.Block  then attemptSound(s,pre,"Block")  end
        if S.abToggles.Charge then attemptSound(s,pre,"Charge") end
        if S.abToggles.Clone  then attemptSound(s,pre,"Clone")  end
    end
    s.Played:Connect(fire)
    s:GetPropertyChangedSignal("IsPlaying"):Connect(function() if s.IsPlaying then fire() end end)
    if s.IsPlaying then fire() end
end


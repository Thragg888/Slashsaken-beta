        if now - S.kpStatusTime >= 1 then
            S.kpStatusTime = now
            pcall(function() Options.KP_Status:SetText("Status: "..(myK and ("Unsupported: "..myK) or "Not a killer")) end)
        end
        return
    end
    local now = tick()
    if now - S.kpStatusTime >= 1 then
        S.kpStatusTime = now
        pcall(function() Options.KP_Status:SetText("Status: Active as "..myK) end)
    end
    if tick() - S.kpLastTime < S.kpCooldown then return end
    local mr = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
    if not mr then return end
    local ability = H.abilityForKiller(myK); if not ability then return end
    for _, ch in ipairs(H.others()) do
        local tr = ch:FindFirstChild("HumanoidRootPart")
        if tr and (tr.Position - mr.Position).Magnitude <= S.kpRange then
            local h = ch:FindFirstChildOfClass("Humanoid")
            local a = h and h:FindFirstChildOfClass("Animator")
            if a then
                for _, t in ipairs(a:GetPlayingAnimationTracks()) do
                    if not S.kpTrackSeen[t] then
                        local ok, id = pcall(function()
                            return tostring(t.Animation and t.Animation.AnimationId or ""):match("%d+")
                        end)
                        if ok and id and S.kpAnimIds[id] then
                            S.kpTrackSeen[t] = true
                            S.kpLastTime = tick()
                            pcall(function() Options.KP_Last:SetText("Last: "..ch.Name.." / "..id) end)
                            if S.kpDelay > 0 then
                                task.delay(S.kpDelay, function() H.fireAbility(ability) end)
                            else
                                H.fireAbility(ability)
                            end
                            break
                        end
                    end
                end
            end
        end
    end
end)


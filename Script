-- Auto raging pace
RunService.Heartbeat:Connect(function()
    if not S.ragingPace then return end
    local f = H.killers(); if not f then return end
    local mr = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
    if not mr then return end
    local set = {}; for _, id in ipairs(IDS.punchAnimIds) do set[id] = true end
    for _, k in ipairs(f:GetChildren()) do
        local hrp = k:FindFirstChild("HumanoidRootPart")
        local h = k:FindFirstChildOfClass("Humanoid")
        if hrp and h and (hrp.Position - mr.Position).Magnitude <= 19 then
            local a = h:FindFirstChildOfClass("Animator")
            if a then
                for _, t in ipairs(a:GetPlayingAnimationTracks()) do
                    local id = tostring(t.Animation.AnimationId):match("%d+")
                    if set[id] then
                        task.spawn(function()
                            local i = 0
                            while i < 20 do
                                H.fireRaging()
                                task.wait(0.05)
                                i = i + 1
                            end
                        end)
                        break
                    end
                end
            end
        end
    end
end)

-- Messages loop
local lastTick = 0
RunService.RenderStepped:Connect(function()
    local now = tick()
    if now - lastTick < 0.08 then return end
    lastTick = now
    if not lp.Character then return end
    local a = cachedAnimator or (refreshAnimator() or cachedAnimator)
    if not a then return end
    local cur = {}
    local ok, tracks = pcall(function() return a:GetPlayingAnimationTracks() end)
    if ok and tracks then
        for _, t in ipairs(tracks) do
            local id
            pcall(function() id = tostring(t.Animation and t.Animation.AnimationId or ""):match("%d+") end)
            if id and table.find(IDS.punchAnimIds, id) then
                cur[id] = true
                if not S._punchPrev[id] and S.messageOn and S.messageBlock
                    and (tick() - S._punchMsg) > S.MSG_CD then
                    pcall(function() H.sendMsg(S.messageBlock) end)
                    S._punchMsg = tick()
                end
            end
        end
    end
    S._punchPrev = cur
end)


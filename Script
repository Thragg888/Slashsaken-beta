    for id in tostring(str or ""):gmatch("%d+") do S.kpAnimIds[id] = true end
    for _, id in ipairs(IDS.guestParryAnims) do S.kpAnimIds[id] = true end
end

function H.facingInfo(hrp)
    local dot = math.clamp(S.customFacingDot or 0.3, -1, 1)
    local angle = math.acos(dot); local frac = angle/math.pi
    local r = math.max(1, S.detectionRange * (0.20 + 0.80*frac))
    local fd = S.detectionRange * (0.35 + 0.15*frac)
    return hrp.Position + hrp.CFrame.LookVector * fd, r
end

function H.inBlockZone(mr, kr)
    if not S.facingCheck then return (mr.Position - kr.Position).Magnitude <= S.detectionRange end
    local c, r = H.facingInfo(kr)
    return (mr.Position - c).Magnitude <= r
end

function H.isFlicking(k, mr, kr)
    if not S.flickOn then return false end
    if (kr.Position - mr.Position).Magnitude > S.flickRange then return false end
    local fd = S.flickData[k]; if not fd then return false end
    return (tick() - fd.lastFlickTick) < S.flickWindow
end

function H.hasLOS(tp)
    if not S.wallCheck then return true end
    local c = lp.Character; local mr = c and c:FindFirstChild("HumanoidRootPart")
    if not mr or not tp then return true end
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    local ex = {c}; local km = tp:FindFirstAncestorOfClass("Model")
    if km then table.insert(ex, km) end
    rp.FilterDescendantsInstances = ex; rp.IgnoreWater = true
    return Workspace:Raycast(mr.Position, tp.Position - mr.Position, rp) == nil
end


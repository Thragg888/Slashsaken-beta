-- Sound hook
local soundHooks, soundBlockedUntil, killerState = {}, {}, {}
local function extractSoundId(s)
    if not s or not s.SoundId then return nil end
    local sid = tostring(s.SoundId)
    return sid:match("rbxassetid://(%d+)") or sid:match("://(%d+)") or sid:match("^(%d+)$")
end
local function getSoundPos(s)
    local p = s and s.Parent
    if not p then return nil end
    if p:IsA("BasePart") then return p.Position, p end
    if p:IsA("Attachment") and p.Parent and p.Parent:IsA("BasePart") then return p.Parent.Position, p.Parent end
    return nil
end
local function getCharFromDesc(i)
    if not i then return nil end
    local m = i:FindFirstAncestorOfClass("Model")
    if m and m:FindFirstChildOfClass("Humanoid") then return m end
    return nil
end

local triggerSoundSet = {}
for _, id in ipairs(IDS.autoBlockTriggerSounds) do triggerSoundSet[id] = true end

local function _attemptForSound(s, idp, mode)
    if not autoBlockAudioOn then return end
    if isHelpless() or isM1LockedOut() then return end
    if not s or not s:IsA("Sound") or not s.IsPlaying then return end
    local now = tick()
    local hk = soundHooks[s]
    local id = idp or (hk and hk.id) or extractSoundId(s)
    if not id or not triggerSoundSet[id] then return end
    if soundBlockedUntil[s] and now < soundBlockedUntil[s] then return end
    if now - lastLocalBlockTime < LOCAL_BLOCK_COOLDOWN then return end
    local mr = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
    if not mr then return end
    local hrp = hk and hk.hrp
    if not hrp then
        local _, p = getSoundPos(s); if not p then return end
        local ch = getCharFromDesc(p); hrp = ch and ch:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
    end
    if not isInBlockZone(mr, hrp) or not hasLineOfSight(hrp) then return end
    local km = hrp.Parent
    if km and isKillerFlicking(km, mr, hrp) then return end
    if blockdelay > 0 then task.wait(blockdelay) end
    if mode == "Block" and autoblockToggles["Block"] then
        if cachedCooldown and cachedCooldown.Text ~= "" then return end
        fireRemoteBlock()
    end
    if mode == "Charge" and autoblockToggles["Charge"] then fireRemoteCharge() end
    if mode == "Clone"  and autoblockToggles["Clone"]  then fireRemoteClone()  end
    lastLocalBlockTime = now; soundBlockedUntil[s] = now + 1.0
end
local function hookSound(s)
    if not s or not s:IsA("Sound") or soundHooks[s] then return end
    local pre = extractSoundId(s)
    soundHooks[s] = { id = pre }
    local function fire()
        if autoblockToggles["Block"]  then _attemptForSound(s, pre, "Block")  end
        if autoblockToggles["Charge"] then _attemptForSound(s, pre, "Charge") end
        if autoblockToggles["Clone"]  then _attemptForSound(s, pre, "Clone")  end
    end
    s.Played:Connect(fire)
    s:GetPropertyChangedSignal("IsPlaying"):Connect(function() if s.IsPlaying then fire() end end)
    if s.IsPlaying then fire() end
end


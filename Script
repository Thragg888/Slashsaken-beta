function F.itemHighlight(item)
    if not (item:IsA("BasePart") or item:IsA("Model")) then return end
    local n = item.Name
    local isM = (n=="Medkit" and S.espMedkit)
    local isB = (n=="BloxyCola" and S.espBloxy)
    if not (isM or isB) then return end
    local t = item:IsA("BasePart") and item or item:FindFirstChildWhichIsA("BasePart")
    if not t or t:FindFirstChild("ItemHighlight") then return end
    local h = Instance.new("Highlight")
    h.Name="ItemHighlight"; h.Adornee=item
    h.FillTransparency=0.5; h.OutlineTransparency=0
    h.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
    if isM then h.FillColor=Color3.fromRGB(255,105,180); h.OutlineColor=h.FillColor
    else h.FillColor=Color3.fromRGB(0,150,255); h.OutlineColor=h.FillColor end
    h.Parent = t
end
function F.scanItems(name)
    for _, item in ipairs(Workspace:GetDescendants()) do
        if item.Name == name then F.itemHighlight(item) end
    end
end
function F.attachGen(obj)
    if not obj or not obj.Parent then return end
    local root = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
    if not root then return end
    local h = Instance.new("Highlight")
    h.Name="esp_g"; h.FillColor=Color3.fromRGB(255,255,0); h.OutlineColor=h.FillColor
    h.FillTransparency=0.6; h.OutlineTransparency=0
    h.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
    h.Adornee=obj; h.Parent=obj
    local bb = Instance.new("BillboardGui")
    bb.Name="esp_g_bb"; bb.Adornee=root
    bb.Size=UDim2.new(0,100,0,20); bb.StudsOffset=Vector3.new(0,3.8,0)
    bb.AlwaysOnTop=true; bb.Parent=obj
    local lbl = Instance.new("TextLabel")
    lbl.Size=UDim2.new(1,0,1,0); lbl.BackgroundTransparency=1
    lbl.TextColor3=Color3.fromRGB(255,255,0); lbl.TextStrokeTransparency=0.5
    lbl.TextSize=15; lbl.Font=Enum.Font.SourceSansBold; lbl.Parent=bb
    local p = obj:FindFirstChild("Progress")
    if p and p:IsA("NumberValue") then
        lbl.Text = "Generator ("..math.floor(p.Value).."%)"
        S.genConns[obj] = p.Changed:Connect(function()
            if lbl.Parent then lbl.Text = "Generator ("..math.floor(p.Value).."%)" end
        end)
    end
end
function F.doGens(on)
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj.Name == "Generator" then
            if on then F.attachGen(obj)
            else
                local h = obj:FindFirstChild("esp_g"); if h then h:Destroy() end
                local b = obj:FindFirstChild("esp_g_bb"); if b then b:Destroy() end
                if S.genConns[obj] then S.genConns[obj]:Disconnect(); S.genConns[obj]=nil end
            end
        end
    end
end
function F.startInvis()
    S.invisRunning = true
    local h = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
    if not h or h.RigType ~= Enum.HumanoidRigType.R6 then return end
    S.invisThread = task.spawn(function()
        while S.invisRunning do
            local a = Instance.new("Animation"); a.AnimationId="rbxassetid://75804462760596"
            local t = h:LoadAnimation(a); S.invisCur = t
            t.Looped=false; t:Play(); t:AdjustSpeed(0); task.wait()
        end
    end)
end
function F.stopInvis()
    S.invisRunning = false
    if S.invisThread then task.cancel(S.invisThread); S.invisThread=nil end
    if S.invisCur then S.invisCur:Stop(); S.invisCur=nil end
end
function F.setInfStamina()
    S.infStamina = true
    if S.stamThread then task.cancel(S.stamThread) end
    S.stamThread = task.spawn(function()
        while S.infStamina do
            task.wait(0.005)
            sprintModule.MaxStamina = S.maxStam
            sprintModule.SprintSpeed = S.sprintSpeed
            sprintModule.StaminaGain = S.stamGain
            sprintModule.StaminaDrain = S.stamDrain
            sprintModule.StaminaRegenDelay = S.regenDelay
            sprintModule.Stamina = sprintModule.MaxStamina
        end
    end)
end


-- Facing / flick / vision
local function getFacingCircleInfo(hrp)
    local dot = math.clamp(customFacingDot or 0.3, -1, 1)
    local angle = math.acos(dot)
    local frac = angle / math.pi
    local r = math.max(1, detectionRange * (0.20 + 0.80 * frac))
    local fd = detectionRange * (0.35 + 0.15 * frac)
    return hrp.Position + hrp.CFrame.LookVector * fd, r
end

local function isInBlockZone(mr, kr)
    if not facingCheckEnabled then return (mr.Position - kr.Position).Magnitude <= detectionRange end
    local c, r = getFacingCircleInfo(kr)
    return (mr.Position - c).Magnitude <= r
end

local function isKillerFlicking(k, mr, kr)
    if not flickProtectionEnabled then return false end
    if (kr.Position - mr.Position).Magnitude > flickRange then return false end
    local fd = flickData[k]
    if not fd then return false end
    return (tick() - fd.lastFlickTick) < flickWindow
end

local function hasLineOfSight(tp)
    if not wallCheckEnabled then return true end
    local c = lp.Character
    local mr = c and c:FindFirstChild("HumanoidRootPart")
    if not mr or not tp then return true end
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    local ex = { c }
    local km = tp:FindFirstAncestorOfClass("Model")
    if km then table.insert(ex, km) end
    rp.FilterDescendantsInstances = ex
    rp.IgnoreWater = true
    return Workspace:Raycast(mr.Position, tp.Position - mr.Position, rp) == nil
end

-- HDT
local function beginDragIntoKiller(killerModel)
    if _hitboxDraggingDebounce or not killerModel or not killerModel.Parent then return end
    local c = lp.Character
    if not c then return end
    local hrp = c:FindFirstChild("HumanoidRootPart")
    local hum = c:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end
    local tr = getKillerHRP(killerModel)
    if not tr then return end
    _hitboxDraggingDebounce = true
    local oldAR = hum.AutoRotate
    pcall(function() hum.AutoRotate = false end)
    local bv = Instance.new("BodyVelocity")
    bv.Name="HDT_BV"; bv.MaxForce=Vector3.new(8e4,0,8e4); bv.Velocity=Vector3.new(); bv.Parent=hrp
    local bg = Instance.new("BodyGyro")
    bg.Name="HDT_Gyro"; bg.MaxTorque=Vector3.new(4e5,4e5,4e5); bg.D=100; bg.P=3000; bg.Parent=hrp
    local speed = Dspeed or 8
    local conn
    conn = RunService.Heartbeat:Connect(function()
        if not _hitboxDraggingDebounce then
            conn:Disconnect()
            if bv.Parent then pcall(function() bv:Destroy() end) end
            if bg.Parent then pcall(function() bg:Destroy() end) end
            pcall(function() hum.AutoRotate = oldAR end)
            return
        end
        if not (c and c.Parent) or not (killerModel and killerModel.Parent) then _hitboxDraggingDebounce=false; return end
        local t = getKillerHRP(killerModel)
        if not t then _hitboxDraggingDebounce=false; return end
        pcall(function() bg.CFrame = CFrame.lookAt(hrp.Position, Vector3.new(t.Position.X, hrp.Position.Y, t.Position.Z)) end)
        local toT = t.Position - hrp.Position
        local hor = Vector3.new(toT.X, 0, toT.Z)
        if hor.Magnitude <= 2 then _hitboxDraggingDebounce=false; return end
        local dir = hor.Unit
        bv.Velocity = Vector3.new(dir.X*speed, bv.Velocity.Y, dir.Z*speed)
    end)
    task.delay(HDT_DURATION, function() if _hitboxDraggingDebounce then _hitboxDraggingDebounce = false end end)
end


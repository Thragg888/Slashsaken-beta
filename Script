-- Survivor aim main loop
RunService.RenderStepped:Connect(function()
    if not S.sAimOn or not F.isSurvivor() then return end
    if tick() - lastSurvivorAnim > 1.5 then return end
    local kr = F.nearestKillerHRP(500); if not kr then return end
    local cam = workspace.CurrentCamera; if not cam then return end
    local pos = kr.Position
    if S.sAimPred ~= "Off" then
        local v = kr.AssemblyLinearVelocity or Vector3.new()
        if v.Magnitude > 200 then v = Vector3.new() end
        pos = pos + v * math.clamp(S.sAimVelLead, 0, 0.75)
    end
    if S.sAimMode == "Camera" or S.sAimMode == "HRP+Camera" then
        cam.CFrame = cam.CFrame:Lerp(CFrame.lookAt(cam.CFrame.Position, pos), S.sAimSmooth)
    end
    if S.sAimMode == "HRP" or S.sAimMode == "HRP+Camera" then
        local c = lp.Character; local mr = c and c:FindFirstChild("HumanoidRootPart")
        if mr then
            local flat = Vector3.new(pos.X, mr.Position.Y, pos.Z)
            if (flat - mr.Position).Magnitude > 0.1 then
                mr.CFrame = mr.CFrame:Lerp(CFrame.lookAt(mr.Position, flat), S.sAimSmooth)
            end
        end
    end
end)


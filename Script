local function attachSurvivorAnimWatcher(char)
    if _survivorAnimConn then pcall(function() _survivorAnimConn:Disconnect() end); _survivorAnimConn = nil end
    local h = char:WaitForChild("Humanoid", 5)
    local a = h and h:WaitForChild("Animator", 5)
    if not a then return end
    _survivorAnimConn = a.AnimationPlayed:Connect(function(track)
        local anim = track.Animation
        if not anim then return end
        local id = tostring(anim.AnimationId):match("%d+")
        if not id then return end

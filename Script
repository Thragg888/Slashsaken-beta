local function loadRemoteIDs()
    local ok, body = pcall(function() return game:HttpGet(ID_URL, true) end)
    if not ok or type(body) ~= "string" or #body < 20 then
        warn("[Slashsaken] ID fetch failed, using fallback")
        return FALLBACK_IDS
    end
    local fn, err = loadstring(body)
    if not fn then warn("[Slashsaken] ID syntax error: " .. tostring(err)); return FALLBACK_IDS end
    local ok2, result = pcall(fn)
    if not ok2 or type(result) ~= "table" then warn("[Slashsaken] ID file did not return a table"); return FALLBACK_IDS end
    local merged = {}
    for key, fb in pairs(FALLBACK_IDS) do merged[key] = (type(result[key])=="table") and result[key] or fb end
    print("[Slashsaken] IDs loaded v" .. tostring(result.version or "?"))
    return merged
end


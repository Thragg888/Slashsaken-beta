        end
    end
    return best, bestD
end

local function pushAbilityId(v, set, name)
    if type(v) == "string" or type(v) == "number" then
        local id = tostring(v):match("%d+")
        if id and not set[id] then set[id] = name end
    elseif type(v) == "table" then
        for _, x in pairs(v) do pushAbilityId(x, set, name) end
    end
end

local function readSurvivorConfig(module)
    local ok, cfg = pcall(require, module)
    if not ok or type(cfg) ~= "table" then return end
    if type(cfg.Animations) == "table" then
        for k, v in pairs(cfg.Animations) do
            if SURVIVOR_ABILITY_ANIM_KEYS[k] then pushAbilityId(v, survivorAbilityAnimIds, k) end
        end
    end
    for _, f in ipairs(SURVIVOR_SOUND_FIELDS) do
        local t = cfg[f]
        if type(t) == "table" then
            for k, v in pairs(t) do
                if SURVIVOR_ABILITY_SOUND_KEYS[k] then pushAbilityId(v, survivorAbilitySoundIds, k) end
            end
        end
    end
end

local function loadSurvivorAbilityIds(char)
    survivorAbilityAnimIds = {}
    survivorAbilitySoundIds = {}
    local A = ReplicatedStorage:FindFirstChild("Assets")
    if not A then return end
    local cn = char:GetAttribute("CharacterName") or char.Name
    local sn = char:GetAttribute("SkinName") or "Default"
    local sf = A:FindFirstChild("Survivors")
    local bc = sf and sf:FindFirstChild(cn)
    if bc then
        local c = bc:FindFirstChild("Config")
        if c then readSurvivorConfig(c) end
    end
    if sn ~= "Default" then
        local sr = A:FindFirstChild("Skins")
        local ss = sr and sr:FindFirstChild("Survivors")
        local sc = ss and ss:FindFirstChild(cn)
        local sfd = sc and sc:FindFirstChild(sn)
        if sfd then
            local c = sfd:FindFirstChild("Config")
            if c then readSurvivorConfig(c) end
        end
    end
end

local function pushSurvivorEvent(n)
    _survivorEventRefCount = _survivorEventRefCount + 1
    _survivorEventActive = true
    _survivorCurrentAbility = n
end
local function popSurvivorEvent()
    _survivorEventRefCount = math.max(0, _survivorEventRefCount - 1)
    if _survivorEventRefCount == 0 then _survivorEventActive = false; _survivorCurrentAbility = nil end
end

local function isPingAbility(a) return a and SURVIVOR_PING_ABILITIES[a] == true end

local function predictKillerHRP(hrp)
    if not hrp then return nil end
    if survivorAimPredictionMode == "Off" then return hrp.Position end
    local vel = hrp.AssemblyLinearVelocity or Vector3.new()
    if vel.Magnitude > 200 then vel = Vector3.new() end
    local vl, pl = 0, 0
    if survivorAimPredictionMode == "Velocity" or survivorAimPredictionMode == "Both" then vl = survivorAimVelocityLead end
    if isPingAbility(_survivorCurrentAbility) and (survivorAimPredictionMode == "Ping" or survivorAimPredictionMode == "Both") then
        local ok, p = pcall(function() return lp:GetNetworkPing() end)
        if ok and type(p) == "number" then pl = math.clamp(p * 0.5 * survivorAimPingMultiplier, 0, 0.5) end
    end
    return hrp.Position + vel * math.clamp(vl + pl, 0, 0.75)
end

local function applySurvivorAim(targetPos, mode, smooth)
    if not targetPos then return end
    smooth = smooth or survivorAimSmooth
    local cam = workspace.CurrentCamera
    if not cam then return end
    if mode == "Camera" or mode == "HRP+Camera" then
        cam.CFrame = cam.CFrame:Lerp(CFrame.lookAt(cam.CFrame.Position, targetPos), smooth)
    end
    if mode == "HRP" or mode == "HRP+Camera" then
        local c = lp.Character
        local mr = c and c:FindFirstChild("HumanoidRootPart")
        if mr then
            local flat = Vector3.new(targetPos.X, mr.Position.Y, targetPos.Z)
            if (flat - mr.Position).Magnitude > 0.1 then
                mr.CFrame = mr.CFrame:Lerp(CFrame.lookAt(mr.Position, flat), smooth)
            end
        end
    end
end


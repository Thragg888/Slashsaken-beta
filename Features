-- HDT drag
function F.beginDragIntoKiller(killerModel)
    if S._hitboxDraggingDebounce or not killerModel or not killerModel.Parent then return end
    local c = lp.Character; if not c then return end
    local hrp = c:FindFirstChild("HumanoidRootPart"); local hum = c:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end
    local tr = H.getKillerHRP(killerModel); if not tr then return end
    S._hitboxDraggingDebounce = true
    local oldAR = hum.AutoRotate
    pcall(function() hum.AutoRotate = false end)
    local bv = Instance.new("BodyVelocity"); bv.MaxForce = Vector3.new(8e4,0,8e4); bv.Velocity = Vector3.new(); bv.Parent = hrp
    local bg = Instance.new("BodyGyro"); bg.MaxTorque = Vector3.new(4e5,4e5,4e5); bg.D = 100; bg.P = 3000; bg.Parent = hrp
    local speed = S.Dspeed or 8
    local conn
    conn = RunService.Heartbeat:Connect(function()
        if not S._hitboxDraggingDebounce then
            conn:Disconnect()
            if bv.Parent then bv:Destroy() end
            if bg.Parent then bg:Destroy() end
            pcall(function() hum.AutoRotate = oldAR end)
            return
        end
        if not (c and c.Parent) or not (killerModel and killerModel.Parent) then S._hitboxDraggingDebounce = false; return end
        local t = H.getKillerHRP(killerModel); if not t then S._hitboxDraggingDebounce = false; return end
        pcall(function() bg.CFrame = CFrame.lookAt(hrp.Position, Vector3.new(t.Position.X, hrp.Position.Y, t.Position.Z)) end)
        local toT = t.Position - hrp.Position; local hor = Vector3.new(toT.X,0,toT.Z)
        if hor.Magnitude <= 2 then S._hitboxDraggingDebounce = false; return end
        local dir = hor.Unit
        bv.Velocity = Vector3.new(dir.X*speed, bv.Velocity.Y, dir.Z*speed)
    end)
    task.delay(S.HDT_DURATION, function() if S._hitboxDraggingDebounce then S._hitboxDraggingDebounce = false end end)
end

-- Survivor helpers
function F.isPlayingSurvivor()
    local c = lp.Character; if not c then return false end
    local p = c.Parent; return p and p.Name == "Survivors"
end

function F.getNearestKillerHRP(maxDist)
    local mr = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart"); if not mr then return nil end
    local f = H.getKillersFolder(); if not f then return nil end
    local best, bestD = nil, maxDist or 500
    for _, k in ipairs(f:GetChildren()) do
        if k:IsA("Model") then
            local hrp = k:FindFirstChild("HumanoidRootPart"); local hum = k:FindFirstChildOfClass("Humanoid")
            if hrp and hum and hum.Health > 0 then
                local d = (hrp.Position - mr.Position).Magnitude
                if d < bestD then best = hrp; bestD = d end
            end
        end
    end
    return best, bestD
end

local SURVIVOR_ABILITY_ANIM_KEYS = {Slash=true,AimGun=true,GunFire=true,GunExplode=true,GunFail=true,Stab=true,LungeStart=true,Lunge=true}
local SURVIVOR_ABILITY_SOUND_KEYS = {Slash=true,GunFire=true,GunExplode=true,GunFail=true,Shoot=true,Stab=true,Lunge=true}
local SURVIVOR_PING_ABILITIES = {AimGun=true,GunFire=true,GunExplode=true,GunFail=true}
local SURVIVOR_SOUND_FIELDS = {"Sounds","Sound","SFX","Sfx","SoundEffects","SoundIds"}
local SURVIVOR_DAGGER_STAB_IDS = {["100725497418533"]=true,["89448354637442"]=true}

local function pushAbilityId(v, set, name)
    if type(v)=="string" or type(v)=="number" then
        local id = tostring(v):match("%d+"); if id and not set[id] then set[id] = name end
    elseif type(v)=="table" then for _, x in pairs(v) do pushAbilityId(x, set, name) end end
end

local function readSurvivorConfig(m)
    local ok, cfg = pcall(require, m); if not ok or type(cfg) ~= "table" then return end
    if type(cfg.Animations)=="table" then
        for k,v in pairs(cfg.Animations) do
            if SURVIVOR_ABILITY_ANIM_KEYS[k] then pushAbilityId(v, S.survivorAbilityAnimIds, k) end
        end
    end
    for _, f in ipairs(SURVIVOR_SOUND_FIELDS) do
        local t = cfg[f]
        if type(t)=="table" then
            for k,v in pairs(t) do
                if SURVIVOR_ABILITY_SOUND_KEYS[k] then pushAbilityId(v, S.survivorAbilitySoundIds, k) end
            end
        end
    end
end

function F.loadSurvivorAbilityIds(char)
    S.survivorAbilityAnimIds = {}
    S.survivorAbilitySoundIds = {}
    local A = ReplicatedStorage:FindFirstChild("Assets"); if not A then return end
    local cn = char:GetAttribute("CharacterName") or char.Name
    local sn = char:GetAttribute("SkinName") or "Default"
    local sf = A:FindFirstChild("Survivors"); local bc = sf and sf:FindFirstChild(cn)
    if bc then local c = bc:FindFirstChild("Config"); if c then readSurvivorConfig(c) end end
    if sn ~= "Default" then
        local sr = A:FindFirstChild("Skins"); local ss = sr and sr:FindFirstChild("Survivors")
        local sc = ss and ss:FindFirstChild(cn); local sfd = sc and sc:FindFirstChild(sn)
        if sfd then local c = sfd:FindFirstChild("Config"); if c then readSurvivorConfig(c) end end
    end
end

local function pushSurvivorEvent(n) S._survivorEventRefCount = S._survivorEventRefCount + 1; S._survivorEventActive = true; S._survivorCurrentAbility = n end
local function popSurvivorEvent()
    S._survivorEventRefCount = math.max(0, S._survivorEventRefCount - 1)
    if S._survivorEventRefCount == 0 then S._survivorEventActive = false; S._survivorCurrentAbility = nil end
end

local function isPingAbility(a) return a and SURVIVOR_PING_ABILITIES[a] == true end

local function predictKillerHRP(hrp)
    if not hrp then return nil end
    if S.survivorAimPredictionMode == "Off" then return hrp.Position end
    local vel = hrp.AssemblyLinearVelocity or Vector3.new()
    if vel.Magnitude > 200 then vel = Vector3.new() end
    local vl, pl = 0, 0
    if S.survivorAimPredictionMode == "Velocity" or S.survivorAimPredictionMode == "Both" then vl = S.survivorAimVelocityLead end
    if isPingAbility(S._survivorCurrentAbility) and (S.survivorAimPredictionMode == "Ping" or S.survivorAimPredictionMode == "Both") then
        local ok, p = pcall(function() return lp:GetNetworkPing() end)
        if ok and type(p)=="number" then pl = math.clamp(p*0.5*S.survivorAimPingMultiplier, 0, 0.5) end
    end
    return hrp.Position + vel * math.clamp(vl+pl, 0, 0.75)
end

local function applySurvivorAim(targetPos, mode, smooth)
    if not targetPos then return end
    smooth = smooth or S.survivorAimSmooth
    local cam = workspace.CurrentCamera; if not cam then return end
    if mode == "Camera" or mode == "HRP+Camera" then
        cam.CFrame = cam.CFrame:Lerp(CFrame.lookAt(cam.CFrame.Position, targetPos), smooth)
    end
    if mode == "HRP" or mode == "HRP+Camera" then
        local c = lp.Character; local mr = c and c:FindFirstChild("HumanoidRootPart")
        if mr then
            local flat = Vector3.new(targetPos.X, mr.Position.Y, targetPos.Z)
            if (flat - mr.Position).Magnitude > 0.1 then
                mr.CFrame = mr.CFrame:Lerp(CFrame.lookAt(mr.Position, flat), smooth)
            end
        end
    end
end

local function stopSurvivorStab()
    if S._survivorStabLerpConn then pcall(function() S._survivorStabLerpConn:Disconnect() end); S._survivorStabLerpConn = nil end
    local hum = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
    if hum then hum.AutoRotate = S._survivorStabOriginalAutoRotate end
    S._survivorStabActive = false
end

function F.triggerAutoStab()
    if not S.survivorStabEnabled or S._survivorStabActive then return end
    if tick() - S._survivorStabLastFire < S.survivorStabCooldown then return end
    local mr = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart"); if not mr then return end
    local kr = F.getNearestKillerHRP(S.survivorStabMaxRange); if not kr then return end
    local killer = kr.Parent
    S._survivorStabActive = true; S._survivorStabLastFire = tick()
    local kcf = kr.CFrame; local bp = kcf.Position - kcf.LookVector * S.survivorStabBehindOffset
    local origin = mr.CFrame
    local behind = CFrame.lookAt(Vector3.new(bp.X, origin.Position.Y, bp.Z), Vector3.new(kcf.Position.X, origin.Position.Y, kcf.Position.Z))
    if S.survivorStabTeleportDelay > 0 then task.wait(S.survivorStabTeleportDelay) end
    local cur = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart"); if not cur then S._survivorStabActive = false; return end
    cur.CFrame = behind; pcall(function() cur.AssemblyLinearVelocity = Vector3.new() end)
    -- follow
    if S._survivorStabLerpConn then pcall(function() S._survivorStabLerpConn:Disconnect() end) end
    local hum = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
    S._survivorStabOriginalAutoRotate = hum and hum.AutoRotate or true
    if hum then hum.AutoRotate = false end
    local endT = tick() + S.survivorStabFollowDuration
    S._survivorStabLerpConn = RunService.RenderStepped:Connect(function()
        if tick() >= endT or not S._survivorStabActive then stopSurvivorStab(); return end
        local ch = lp.Character; local mr2 = ch and ch:FindFirstChild("HumanoidRootPart"); if not mr2 then stopSurvivorStab(); return end
        local kr2 = killer and killer:FindFirstChild("HumanoidRootPart"); if not kr2 or not kr2.Parent then stopSurvivorStab(); return end
        local kcf2 = kr2.CFrame; local bp2 = kcf2.Position - kcf2.LookVector * S.survivorStabBehindOffset
        local tcf = CFrame.lookAt(Vector3.new(bp2.X, mr2.Position.Y, bp2.Z), Vector3.new(kcf2.Position.X, mr2.Position.Y, kcf2.Position.Z))
        mr2.CFrame = mr2.CFrame:Lerp(tcf, 0.5); pcall(function() mr2.AssemblyLinearVelocity = Vector3.new() end)
    end)
end


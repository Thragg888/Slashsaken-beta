                            S.killerParryTrackSeen[t] = true; S.killerParryLastTime = tick()
                            H.setKillerParryLastLabel(ch.Name.." / "..id.." → "..ability)
                            if S.killerParryDelay > 0 then task.delay(S.killerParryDelay, function() H.fireKillerAbility(ability) end)
                            else H.fireKillerAbility(ability) end
                            break
                        end
                    end
                end
            end
        end
    end
end)


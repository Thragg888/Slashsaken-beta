local function attachSurvivorAnimWatcher(char)
    if S._survivorAnimConn then pcall(function() S._survivorAnimConn:Disconnect() end); S._survivorAnimConn = nil end
    local h = char:WaitForChild("Humanoid", 5); local a = h and h:WaitForChild("Animator", 5)
    if not a then return end
    S._survivorAnimConn = a.AnimationPlayed:Connect(function(track)
        local anim = track.Animation; if not anim then return end
        local id = tostring(anim.AnimationId):match("%d+"); if not id then return end
        if S.survivorAimDebug then print("[Survivor] anim:", id, S.survivorAbilityAnimIds[id] or anim.Name or "") end
        local name = S.survivorAbilityAnimIds[id]
        if name then
            pushSurvivorEvent(name)
            local ended = false
            local function finish() if ended then return end; ended = true; popSurvivorEvent() end
            track.Stopped:Once(finish)
            local dur = track.Length; if not dur or dur <= 0 then dur = 0.5 end
            task.delay(dur + 0.2, finish)
        end
        if S.survivorStabEnabled and (SURVIVOR_DAGGER_STAB_IDS[id] or name == "Stab") then
            task.spawn(F.triggerAutoStab)
        end
    end)
end

local function hookSurvivorSound(s)
    if not s:IsA("Sound") then return end
    return s.Playing:Connect(function()
        local sid = s.SoundId and tostring(s.SoundId):match("%d+"); if not sid then return end
        if S.survivorAimDebug then print("[Survivor] sound:", sid, S.survivorAbilitySoundIds[sid] or s.Name or "") end
        local name = S.survivorAbilitySoundIds[sid]; if not name then return end
        pushSurvivorEvent(name)
        local dur = s.TimeLength; if not dur or dur <= 0 then dur = 0.4 end
        task.delay(dur + 0.15, popSurvivorEvent)
    end)
end

local function attachSurvivorSoundWatcher(char)
    for _, c in ipairs(S._survivorSoundConns) do pcall(function() c:Disconnect() end) end
    S._survivorSoundConns = {}
    for _, s in ipairs(char:GetDescendants()) do
        if s:IsA("Sound") then local c = hookSurvivorSound(s); if c then table.insert(S._survivorSoundConns, c) end end
    end
    table.insert(S._survivorSoundConns, char.DescendantAdded:Connect(function(d)
        if d:IsA("Sound") then local c = hookSurvivorSound(d); if c then table.insert(S._survivorSoundConns, c) end end
    end))
end


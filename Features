-- Sound hook
local function extractSoundId(s)
    if not s or not s.SoundId then return nil end
    local sid = tostring(s.SoundId)
    return sid:match("rbxassetid://(%d+)") or sid:match("://(%d+)") or sid:match("^(%d+)$")
end
local function getSoundPos(s)
    local p = s and s.Parent; if not p then return nil end
    if p:IsA("BasePart") then return p.Position, p end
    if p:IsA("Attachment") and p.Parent and p.Parent:IsA("BasePart") then return p.Parent.Position, p.Parent end
    return nil
end
local function getCharFromDesc(i)
    if not i then return nil end
    local m = i:FindFirstAncestorOfClass("Model")
    if m and m:FindFirstChildOfClass("Humanoid") then return m end
    return nil
end

local triggerSoundSet = {}
for _, id in ipairs(IDS.autoBlockTriggerSounds) do triggerSoundSet[id] = true end

local function attemptForSound(s, idp, mode)
    if not S.autoBlockAudioOn or H.isHelpless() or H.isM1LockedOut() then return end
    if not s or not s:IsA("Sound") or not s.IsPlaying then return end
    local now = tick(); local hk = S.soundHooks[s]
    local id = idp or (hk and hk.id) or extractSoundId(s)
    if not id or not triggerSoundSet[id] then return end
    if S.soundBlockedUntil[s] and now < S.soundBlockedUntil[s] then return end
    if now - S.lastLocalBlockTime < S.LOCAL_BLOCK_COOLDOWN then return end
    local mr = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart"); if not mr then return end
    local hrp = hk and hk.hrp
    if not hrp then
        local _, p = getSoundPos(s); if not p then return end
        local ch = getCharFromDesc(p); hrp = ch and ch:FindFirstChild("HumanoidRootPart"); if not hrp then return end
    end
    if not H.isInBlockZone(mr, hrp) or not H.hasLineOfSight(hrp) then return end
    local km = hrp.Parent; if km and H.isKillerFlicking(km, mr, hrp) then return end
    if S.blockdelay > 0 then task.wait(S.blockdelay) end
    if mode == "Block" and S.autoblockToggles["Block"] then
        if SA.Options and SA.Options.AB_BlockMode then
            -- still check cooldown UI
        end
        H.fireRemoteBlock()
    end
    if mode == "Charge" and S.autoblockToggles["Charge"] then H.fireRemoteCharge() end
    if mode == "Clone" and S.autoblockToggles["Clone"] then H.fireRemoteClone() end
    S.lastLocalBlockTime = now; S.soundBlockedUntil[s] = now + 1.0
end

local function hookSound(s)
    if not s or not s:IsA("Sound") or S.soundHooks[s] then return end
    local pre = extractSoundId(s); S.soundHooks[s] = {id = pre}
    local function fire()
        if S.autoblockToggles["Block"] then attemptForSound(s, pre, "Block") end
        if S.autoblockToggles["Charge"] then attemptForSound(s, pre, "Charge") end
        if S.autoblockToggles["Clone"] then attemptForSound(s, pre, "Clone") end
    end
    s.Played:Connect(fire)
    s:GetPropertyChangedSignal("IsPlaying"):Connect(function() if s.IsPlaying then fire() end end)
    if s.IsPlaying then fire() end
end

-- Invis
local invisAnimId = "75804462760596"
function F.StartInvisibility()
    S.invisRunning = true
    local h = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
    if not h or h.RigType ~= Enum.HumanoidRigType.R6 then return end
    S.invisThread = task.spawn(function()
        while S.invisRunning do
            local a = Instance.new("Animation"); a.AnimationId = "rbxassetid://"..invisAnimId
            local t = h:LoadAnimation(a); S.invisCurrent = t; t.Looped=false; t:Play(); t:AdjustSpeed(0); task.wait()
        end
    end)
end
function F.StopInvisibility()
    S.invisRunning = false
    if S.invisThread then task.cancel(S.invisThread); S.invisThread = nil end
    if S.invisCurrent then S.invisCurrent:Stop(); S.invisCurrent = nil end
end

-- ESP
function F.clearList(l) for _, h in ipairs(l) do if h and h.Parent then h:Destroy() end end; return {} end
function F.createHighlight(m, col, l)
    if not m or not m:FindFirstChild("HumanoidRootPart") then return end
    local h = Instance.new("Highlight")
    h.Adornee=m; h.FillColor=col; h.OutlineColor=col; h.FillTransparency=0.65; h.OutlineTransparency=0
    h.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop; h.Parent=m; table.insert(l, h)
end
function F.applyItemHighlight(item)
    if not (item:IsA("BasePart") or item:IsA("Model")) then return end
    local n = item.Name
    local isM = (n=="Medkit" and S.espMedkitActive); local isB = (n=="BloxyCola" and S.espBloxyActive)
    if not (isM or isB) then return end
    local t = item:IsA("BasePart") and item or item:FindFirstChildWhichIsA("BasePart")
    if not t or t:FindFirstChild("ItemHighlight") then return end
    local h = Instance.new("Highlight"); h.Name="ItemHighlight"; h.Adornee=item
    h.FillTransparency=0.5; h.OutlineTransparency=0; h.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
    if isM then h.FillColor=Color3.fromRGB(255,105,180); h.OutlineColor=h.FillColor; table.insert(S.medkitHighlights, h)
    else h.FillColor=Color3.fromRGB(0,150,255); h.OutlineColor=h.FillColor; table.insert(S.bloxyHighlights, h) end
    h.Parent = t
end
function F.scanItems(n)
    if n=="Medkit" then S.medkitHighlights = F.clearList(S.medkitHighlights) else S.bloxyHighlights = F.clearList(S.bloxyHighlights) end
    for _, item in ipairs(Workspace:GetDescendants()) do if item.Name == n then F.applyItemHighlight(item) end end
end
function F.espAttachGenerator(obj)
    if not obj or not obj.Parent then return end
    local root = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart"); if not root then return end
    local h = Instance.new("Highlight"); h.Name="esp_g"; h.FillColor=Color3.fromRGB(255,255,0); h.OutlineColor=h.FillColor
    h.FillTransparency=0.6; h.OutlineTransparency=0; h.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
    h.Adornee=obj; h.Parent=obj
    local bb = Instance.new("BillboardGui"); bb.Name="esp_g_bb"; bb.Adornee=root
    bb.Size=UDim2.new(0,100,0,20); bb.StudsOffset=Vector3.new(0,3.8,0); bb.AlwaysOnTop=true; bb.Parent=obj
    local lbl = Instance.new("TextLabel"); lbl.Size=UDim2.new(1,0,1,0); lbl.BackgroundTransparency=1
    lbl.TextColor3=Color3.fromRGB(255,255,0); lbl.TextStrokeTransparency=0.5; lbl.TextSize=15
    lbl.Font=Enum.Font.SourceSansBold; lbl.Parent=bb
    local p = obj:FindFirstChild("Progress")
    if p and p:IsA("NumberValue") then
        lbl.Text = "Generator ("..math.floor(p.Value).."%)"
        S.generatorProgConns[obj] = p.Changed:Connect(function() if lbl.Parent then lbl.Text = "Generator ("..math.floor(p.Value).."%)" end end)
    end
end
function F.espDoGenerators(on)
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj.Name == "Generator" then
            if on then F.espAttachGenerator(obj)
            else
                local h = obj:FindFirstChild("esp_g"); if h then h:Destroy() end
                local b = obj:FindFirstChild("esp_g_bb"); if b then b:Destroy() end
                if S.generatorProgConns[obj] then S.generatorProgConns[obj]:Disconnect(); S.generatorProgConns[obj]=nil end
            end
        end
    end
end


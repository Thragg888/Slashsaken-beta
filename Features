function F.setStamina()
    S.infinityStaminaActive = true
    if S.staminaThread then task.cancel(S.staminaThread) end
    S.staminaThread = task.spawn(function()
        while S.infinityStaminaActive do
            task.wait(0.005)
            SA.sprintModule.MaxStamina = S.maxStaminaValue
            SA.sprintModule.SprintSpeed = S.sprintSpeedValue
            SA.sprintModule.StaminaGain = S.staminaGainValue
            SA.sprintModule.StaminaDrain = S.staminaDrainValue
            SA.sprintModule.StaminaRegenDelay = S.regenDelayValue
            SA.sprintModule.Stamina = SA.sprintModule.MaxStamina
        end
    end)
end


-- Killer state
RunService.RenderStepped:Connect(function(dt)
    if dt <= 0 then return end
    local f = H.getKillersFolder(); if not f then return end
    for _, k in ipairs(f:GetChildren()) do
        local hrp = k:FindFirstChild("HumanoidRootPart")
        if hrp then
            local st = S.killerState[k] or {prevPos=hrp.Position, prevLook=hrp.CFrame.LookVector, vel=Vector3.new(), angVel=0, rawAngVel=0}
            st.vel = (hrp.Position - st.prevPos)/math.max(dt, 1e-6); st.prevPos = hrp.Position
            local prev = st.prevLook or hrp.CFrame.LookVector; local cur = hrp.CFrame.LookVector
            local dot = math.clamp(prev:Dot(cur), -1, 1); local ang = math.acos(dot)
            local crossY = prev:Cross(cur).Y; local sign = (crossY >= 0) and 1 or -1
            local raw = (ang/math.max(dt,1e-6))*sign; st.rawAngVel = raw
            st.angVel = (st.angVel or 0)*0.78 + raw*0.22; st.prevLook = cur
            if S.flickProtectionEnabled then
                local dps = math.abs(raw)*(180/math.pi)
                if dps > S.flickDegPerSecThreshold then S.flickData[k] = {lastFlickTick = tick()} end
            end
            S.killerState[k] = st
        end
    end
end)


local function loadRemoteIDs()
    warn("[core] fetching IDs...")
    local ok, body = pcall(function() return game:HttpGet(ID_URL, true) end)
    if not ok or type(body) ~= "string" or #body < 20 then
        warn("[core] ID fetch failed, fallback"); return FALLBACK_IDS
    end
    local fn = loadstring(body)
    if not fn then warn("[core] ID syntax error, fallback"); return FALLBACK_IDS end
    local ok2, result = pcall(fn)
    if not ok2 or type(result) ~= "table" then warn("[core] ID not table, fallback"); return FALLBACK_IDS end
    local merged = {}
    for k, v in pairs(FALLBACK_IDS) do merged[k] = (type(result[k])=="table") and result[k] or v end
    for k, v in pairs(result) do if merged[k] == nil then merged[k] = v end end
    warn("[core] IDs loaded v" .. tostring(result.version or "?"))
    return merged
end


local H = {}
SA.H = H

function H.isHelpless()
    local c = lp.Character; if not c then return true end
    if c:GetAttribute("Helpless")==true or c:GetAttribute("Stunned")==true then return true end
    if c:FindFirstChild("Helpless") or c:FindFirstChild("Stunned") then return true end
    local se = c:FindFirstChild("StatusEffects")
    if se and (se:FindFirstChild("Helpless") or se:FindFirstChild("Stunned")) then return true end
    local st = c:FindFirstChild("Status")
    if st and (st:FindFirstChild("Helpless") or st:FindFirstChild("Stunned")) then return true end
    local hum = c:FindFirstChildOfClass("Humanoid")
    if hum then
        if hum:GetAttribute("Helpless")==true then return true end
        if hum.Health<=0 then return true end
    end
    return false
end

function H.isM1LockedOut()
    if not S.m1LockoutEnabled or S.lastM1Time==0 then return false end
    return (tick()-S.lastM1Time) < S.M1_RECOVERY
end

function H.getKillersFolder()
    local p = Workspace:FindFirstChild("Players")
    return p and p:FindFirstChild("Killers")
end

function H.getNearestKillerModel()
    local mr = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
    if not mr then return nil end
    local f = H.getKillersFolder(); if not f then return nil end
    local best, bestD = nil, math.huge
    for _, k in ipairs(f:GetChildren()) do
        local hrp = k:FindFirstChild("HumanoidRootPart")
        if hrp then
            local d = (hrp.Position - mr.Position).Magnitude
            if d < bestD then best= k; bestD = d end
        end
    end
    return best
end

function H.getKillerHRP(m)
    if not m then return nil end
    return m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart or m:FindFirstChildWhichIsA("BasePart", true)
end

function H.fireKillerAbility(name)
    if not name or name=="" then return end
    local bytes = {3, #name, 0, 0, 0}
    for i=1,#name do table.insert(bytes, string.byte(name,i)) end
    testRemote:FireServer("UseActorAbility", {
        (function(b) local buf=buffer.create(#b); for i=1,#b do buffer.writeu8(buf,i-1,b[i]) end; return buf end)(bytes)
    })
end

function H.getMyKillerName()
    local PF = Workspace:FindFirstChild("Players"); if not PF then return nil end
    local K = PF:FindFirstChild("Killers"); if not K then return nil end
    for _, m in ipairs(K:GetChildren()) do
        if m:IsA("Model") and Players:GetPlayerFromCharacter(m) == lp then return m.Name end
    end
    return nil
end

local supportedSet = {}
for _, n in ipairs(IDS.parrySupportedKillers or {"johndoe","slasher"}) do supportedSet[n:lower()] = true end
function H.isSupportedKiller(n) return n and supportedSet[n:lower()] or false end
function H.abilityForKiller(n) return n and (IDS.killerAbilities or {})[n:lower()] end

function H.getAllOtherCharacters()
    local list = {}
    local PF = Workspace:FindFirstChild("Players"); if not PF then return list end
    for _, fn in ipairs({"Survivors","Killers"}) do
        local f = PF:FindFirstChild(fn)
        if f then for _, m in ipairs(f:GetChildren()) do
            if m:IsA("Model") and m ~= lp.Character then table.insert(list, m) end
        end end
    end
    return list
end

function H.updateKillerParryAnims(str)
    S.killerParryAnimIds = {}
    for id in tostring(str or ""):gmatch("%d+") do S.killerParryAnimIds[id] = true end
    for _, id in ipairs(IDS.guestParryAnims) do S.killerParryAnimIds[id] = true end
end

function H.setKillerParryLastLabel(txt) pcall(function() SA.Options.KP_LastTrigger:SetText("Last trigger: "..tostring(txt)) end) end
function H.setKillerParryStatus(txt)
    local now = tick()
    if now - S.killerParryLastStatusTime < 1 then return end
    S.killerParryLastStatusTime = now
    pcall(function() SA.Options.KP_Status:SetText("Status: "..tostring(txt)) end)
end

function H.getFacingCircleInfo(hrp)
    local dot = math.clamp(S.customFacingDot or 0.3, -1, 1)
    local angle = math.acos(dot); local frac = angle/math.pi
    local r = math.max(1, S.detectionRange * (0.20 + 0.80*frac))
    local fd = S.detectionRange * (0.35 + 0.15*frac)
    return hrp.Position + hrp.CFrame.LookVector * fd, r
end

function H.isInBlockZone(mr, kr)
    if not S.facingCheckEnabled then return (mr.Position - kr.Position).Magnitude <= S.detectionRange end
    local c, r = H.getFacingCircleInfo(kr)
    return (mr.Position - c).Magnitude <= r
end

function H.isKillerFlicking(k, mr, kr)
    if not S.flickProtectionEnabled then return false end
    if (kr.Position - mr.Position).Magnitude > S.flickRange then return false end
    local fd = S.flickData[k]; if not fd then return false end
    return (tick() - fd.lastFlickTick) < S.flickWindow
end

function H.hasLineOfSight(tp)
    if not S.wallCheckEnabled then return true end
    local c = lp.Character; local mr = c and c:FindFirstChild("HumanoidRootPart")
    if not mr or not tp then return true end
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    local ex = {c}; local km = tp:FindFirstAncestorOfClass("Model")
    if km then table.insert(ex, km) end
    rp.FilterDescendantsInstances = ex; rp.IgnoreWater = true
    return Workspace:Raycast(mr.Position, tp.Position - mr.Position, rp) == nil
end

function H.fireRemoteBlock()
    if H.isHelpless() then return end
    if S.hitboxDraggingTech and S.comboCooldownActive and (tick()-S.lastComboTime) < S.COMBO_COOLDOWN then return end
    testRemote:FireServer("UseActorAbility", {(function(b) local buf=buffer.create(#b); for i=1,#b do buffer.writeu8(buf,i-1,b[i]) end; return buf end)({3,5,0,0,0,66,108,111,99,107})})
    if S.hitboxDraggingTech then
        S.comboCooldownActive = true; S.lastComboTime = tick()
        pcall(function() Library:Notify({Title="Cooldown", Description="Block+HDT on 27s cooldown", Time=3}) end)
        task.spawn(function()
            local n = H.getNearestKillerModel()
            if n then SA.F.beginDragIntoKiller(n) end
        end)
    end
end
